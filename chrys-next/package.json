{
  "name": "chrys-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/cjs/index.d.ts",
  "unpkg": "./dist/umd/index.min.js",
  "jsdelivr": "./dist/umd/index.min.js",
  "sideEffects": false,
  "browserslist": [
    "chrome >= 93",
    "and_chr >= 93",
    "edge >= 93",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "firefox >= 92",
    "and_ff >= 92",
    "samsung >= 17",
    "opera >= 79"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/es/index.js"
    },
    "./best-color-contrast": {
      "import": {
        "types": "./dist/es/bestColorContrast.d.ts",
        "default": "./dist/es/bestColorContrast.js"
      },
      "require": {
        "types": "./dist/cjs/bestColorContrast.d.ts",
        "default": "./dist/cjs/bestColorContrast.js"
      },
      "default": "./dist/es/bestColorContrast.js"
    },
    "./core": {
      "import": {
        "types": "./dist/es/toDiscretePalette.d.ts",
        "default": "./dist/es/toDiscretePalette.js"
      },
      "require": {
        "types": "./dist/cjs/toDiscretePalette.d.ts",
        "default": "./dist/cjs/toDiscretePalette.js"
      },
      "default": "./dist/es/toDiscretePalette.js"
    },
    "./bokeh": {
      "import": {
        "types": "./dist/es/palettes/bokeh/index.d.ts",
        "default": "./dist/es/palettes/bokeh/index.js"
      },
      "require": {
        "types": "./dist/cjs/palettes/bokeh/index.d.ts",
        "default": "./dist/cjs/palettes/bokeh/index.js"
      },
      "default": "./dist/es/palettes/bokeh/index.js"
    },
    "./vega": {
      "import": {
        "types": "./dist/es/palettes/vega/index.d.ts",
        "default": "./dist/es/palettes/vega/index.js"
      },
      "require": {
        "types": "./dist/cjs/palettes/vega/index.d.ts",
        "default": "./dist/cjs/palettes/vega/index.js"
      },
      "default": "./dist/es/palettes/vega/index.js"
    },
    "./palettes/*": {
      "import": {
        "types": "./dist/es/palettes/*.d.ts",
        "default": "./dist/es/palettes/*.js"
      },
      "require": {
        "types": "./dist/cjs/palettes/*.d.ts",
        "default": "./dist/cjs/palettes/*.js"
      },
      "default": "./dist/es/palettes/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:cjs": "vite build --mode cjs",
    "build:css": "node scripts/build-css.js",
    "build:demo": "node scripts/build-demo.js",
    "build:es": "vite build --mode es",
    "build:illustrator": "node scripts/build-illustrator.js",
    "build:types:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:types:es": "tsc -p tsconfig.build.json",
    "build:umd": "vite build --mode umd && vite build --mode umd-min",
    "build": "npm run clean && npm run generate:palettes && npm run build:es && npm run build:cjs && npm run build:umd && npm run build:types:es && npm run build:types:cjs && npm run build:css && npm run build:illustrator && npm run build:demo",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "npm run generate:palettes && vite",
    "generate:palettes": "node ../scripts/build-palette-modules.js",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run generate:palettes && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/chroma-js": "3.1.3",
    "@types/node": "26.6.6",
    "autoprefixer": "10.6.2",
    "browserslist": "4.29.5",
    "chrys-cli": "2.1.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-browserslist": "4.0.0",
    "fs-extra": "11.4.1",
    "globby": "16.2.4",
    "lodash": "4.18.1",
    "npm-check-updates": "23.1.1",
    "nunjucks": "3.2.4",
    "oxlint": "1.90.0",
    "postcss": "8.5.32",
    "sass-embedded": "1.107.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "chroma-js": "3.2.0",
    "sass-apca": "1.2.0"
  }
}
