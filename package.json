{
  "name": "chrys",
  "version": "5.4.1",
  "description": "A collection of color palettes for visualisation in JavaScript, Python and Sass",
  "repository": {
    "type": "git",
    "url": "git://github.com/netbek/chrys.git"
  },
  "author": {
    "name": "Hein Bekker",
    "email": "hein@netbek.co.za",
    "url": "https://www.netbek.co.za"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/netbek/chrys/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/cjs/index.d.ts",
  "unpkg": "./dist/umd/index.min.js",
  "jsdelivr": "./dist/umd/index.min.js",
  "sideEffects": false,
  "browserslist": [
    "chrome >= 93",
    "and_chr >= 93",
    "edge >= 93",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "firefox >= 92",
    "and_ff >= 92",
    "samsung >= 17",
    "opera >= 79"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/es/index.js"
    },
    "./utils/best-color-contrast": {
      "import": {
        "types": "./dist/es/utils/best-color-contrast.d.ts",
        "default": "./dist/es/utils/best-color-contrast.js"
      },
      "require": {
        "types": "./dist/cjs/utils/best-color-contrast.d.ts",
        "default": "./dist/cjs/utils/best-color-contrast.js"
      },
      "default": "./dist/es/utils/best-color-contrast.js"
    },
    "./utils/parse-color": {
      "import": {
        "types": "./dist/es/utils/parse-color.d.ts",
        "default": "./dist/es/utils/parse-color.js"
      },
      "require": {
        "types": "./dist/cjs/utils/parse-color.d.ts",
        "default": "./dist/cjs/utils/parse-color.js"
      },
      "default": "./dist/es/utils/parse-color.js"
    },
    "./utils/to-discrete-colors": {
      "import": {
        "types": "./dist/es/utils/to-discrete-colors.d.ts",
        "default": "./dist/es/utils/to-discrete-colors.js"
      },
      "require": {
        "types": "./dist/cjs/utils/to-discrete-colors.d.ts",
        "default": "./dist/cjs/utils/to-discrete-colors.js"
      },
      "default": "./dist/es/utils/to-discrete-colors.js"
    },
    "./utils/to-continuous-colors": {
      "import": {
        "types": "./dist/es/utils/to-continuous-colors.d.ts",
        "default": "./dist/es/utils/to-continuous-colors.js"
      },
      "require": {
        "types": "./dist/cjs/utils/to-continuous-colors.d.ts",
        "default": "./dist/cjs/utils/to-continuous-colors.js"
      },
      "default": "./dist/es/utils/to-continuous-colors.js"
    },
    "./utils/parse-palette-name": {
      "import": {
        "types": "./dist/es/utils/parse-palette-name.d.ts",
        "default": "./dist/es/utils/parse-palette-name.js"
      },
      "require": {
        "types": "./dist/cjs/utils/parse-palette-name.d.ts",
        "default": "./dist/cjs/utils/parse-palette-name.js"
      },
      "default": "./dist/es/utils/parse-palette-name.js"
    },
    "./utils/get-palette-colors": {
      "import": {
        "types": "./dist/es/utils/get-palette-colors.d.ts",
        "default": "./dist/es/utils/get-palette-colors.js"
      },
      "require": {
        "types": "./dist/cjs/utils/get-palette-colors.d.ts",
        "default": "./dist/cjs/utils/get-palette-colors.js"
      },
      "default": "./dist/es/utils/get-palette-colors.js"
    },
    "./palettes/*": {
      "import": {
        "types": "./dist/es/palettes/*.d.ts",
        "default": "./dist/es/palettes/*.js"
      },
      "require": {
        "types": "./dist/cjs/palettes/*.d.ts",
        "default": "./dist/cjs/palettes/*.js"
      },
      "default": "./dist/es/palettes/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:cjs": "vite build --mode cjs",
    "build:css": "node scripts/build-css.js",
    "build:demo": "node scripts/build-demo.js",
    "build:es": "vite build --mode es",
    "build:illustrator": "node scripts/build-illustrator.js",
    "build:types:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:types:es": "tsc -p tsconfig.build.json",
    "build:umd": "vite build --mode umd && vite build --mode umd-min",
    "build": "npm run clean && npm run generate:palettes && npm run build:es && npm run build:cjs && npm run build:umd && npm run build:types:es && npm run build:types:cjs && npm run build:css && npm run build:illustrator && npm run build:demo",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "npm run generate:palettes && vite",
    "generate:palettes": "node scripts/build-palette-modules.js",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "test": "npm run generate:palettes && vitest run",
    "test:coverage": "npm run generate:palettes && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@bokeh/bokehjs": "2.4.3",
    "@netbek/skills-manager": "0.2.1",
    "@types/apca-w3": "0.1.3",
    "@types/chroma-js": "3.1.3",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.2",
    "browserslist": "4.29.5",
    "chroma-js": "3.2.0",
    "chrys-cli": "2.1.4",
    "d3-scale-chromatic": "3.1.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-browserslist": "4.0.0",
    "fs-extra": "11.4.1",
    "gh-pages": "6.3.0",
    "globby": "16.2.4",
    "jquery": "4.0.0",
    "lodash": "4.18.1",
    "normalize-css": "github:necolas/normalize.css#02c5c7adbbec1707900fde86068405735c733b42",
    "npm-check-updates": "23.1.1",
    "nunjucks": "3.2.4",
    "oxlint": "1.91.0",
    "patch-package": "8.0.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prism-themes": "1.9.0",
    "prismjs": "1.30.0",
    "sass-embedded": "1.108.0",
    "typescript": "7.0.2",
    "vega-scale": "7.4.3",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "apca-w3": "0.1.9",
    "sass-apca": "1.2.0"
  }
}
